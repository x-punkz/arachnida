#!/usr/bin/env python3
import urllib.request
import argparse
import os
import re


def recursive_parse(
        parser: argparse.ArgumentParser,
        args: argparse.Namespace
        ) -> int:
    if args.limit is not None and not args.recursive:
        parser.error("The [-l] option requires that recursive mode [-r] be "
                     "enabled.")

    if args.limit is not None and args.limit <= 0:
        parser.error("The value of [-l] must be greater than 0.")

    if args.limit is None:
        args.limit = 5

    return args.limit


def split_url(url: str) -> list[str]:
    schema = url.partition("://")[0]
    host = url.split("://", 1)[-1]
    host_port, rest = re.match(r'([^/?#]*)(.*)', host).groups()

    return (schema, host, host_port, rest)


def url_validate(url: str) -> None | str:
    if not url.lower().startswith(("https://", "http://")):
        return "The [url] must begin with http:// or https://."

    _, host, host_port, _ = split_url(url)

    if host.startswith("["):
        return "IPv6 not supported."

    domain, sep, port = host_port.partition(":")

    labels = domain.split(".")
    is_valid_domain = True
    for label in labels:
        # fullmatch so pega se o texto todo obedecer a regra e devolve um
        # obj match ou none
        if not re.fullmatch(r"[a-zA-Z0-9-]{1,63}", label):
            is_valid_domain = False
            break
        if label.startswith("-") or label.endswith("-"):
            is_valid_domain = False
            break

    if not is_valid_domain:
        return "In URL, [domain] is invalid."

    if sep == ":":
        if (not (port.isascii() and port.isdigit())
                or int(port) not in range(1, 65536)):
            return "In URL, [port] is invalid."

    return None


def path_validate_and_create(path: str) -> None | str:
    if os.path.exists(path):
        if not os.path.isdir(path):
            return "[path] is not a directory."

        if not os.access(path, os.W_OK | os.X_OK):
            return "The directory in [path] is not writable."
    else:
        try:
            os.makedirs(path, exist_ok=True)
            print(
                "[INFO] The directory does not exist in the path\n"
                f"created directory '{path}'"
                )
        except OSError as e:
            return f"Cannot create directory '{path}': {e}"

    return None


def arguments() -> tuple[bool, int, str, str]:
    parser = argparse.ArgumentParser(
        prog='Spider',
        formatter_class=argparse.RawTextHelpFormatter,
        description="The spider program allow you to extract all the images "
        "from a website,\n recursively, by providing a url as a parameter.\n"
        "By default, the program will download the following file "
        "extensions:\n"
        "   .jpg/.jpeg, .png, .gif, .bmp",
        epilog='''Examples:
        ./spider -r -l 8 https://www.example.com
        ./spider -r -p /home/user/data https://www.example.com

        [-l] is only used if -r is also being used;
            Otherwise, [-l] will not work.
        If -l is not define, it defaults to "5".
        If -p is not define, the default is "./data/".''',
        # color=False
    )
    parser.add_argument(
        "-r",
        "--recursive",
        action='store_true',
        help='Recursively downloads the images in a URL received '
        'as a parameter',
    )

    parser.add_argument(
        "-l",
        "--limit",
        type=int,
        default=None,
        help="Set the recursion value"
    )

    parser.add_argument(
        "-p",
        "--path",
        type=str,
        help="Set the path for saving the download",
        default="./data/"
    )

    parser.add_argument(
        "url",
        type=str,
        help="The URL of the website from which the images are to be extracted"
    )

    args = parser.parse_args()

    args.limit = recursive_parse(parser, args)

    url_error = url_validate(args.url)
    if url_error:
        parser.error(url_error)

    path_error = path_validate_and_create(args.path)
    if path_error:
        parser.error(path_error)

    return (args.recursive, args.limit, args.path, args.url)


def get_page(url: str) -> tuple[str | None, str | None]:
    try:
        with urllib.request.urlopen(url, timeout=5) as resp:
            content = resp.headers.get_content_type()
            if content != "text/html":
                print(f"Ignored: {url} is {content}")
                return None, None
            data = resp.read()
            charset = resp.headers.get_content_charset("utf-8")
            converted_data = data.decode(charset, errors="replace")
            return (converted_data, resp.url)
    except OSError as e:
        print(e)
        return None, None


def extract_images_path(html: str) -> list[str]:
    images_line: list[str]
    images: list[str] = []

    images_line = re.findall(r"<img\s[^>]*>", html, re.IGNORECASE)

    for tag_img in images_line:
        matchs = re.search(
            r'\ssrc=(?:"([^\"]*)"|\'([^\']*)\'|([^\s>]+))',
            tag_img,
            re.IGNORECASE
        )
        if matchs and any(matchs.groups()):
            images.append(
                (matchs.group(1) or matchs.group(2) or matchs.group(3))
                .replace("&amp;", "&")
            )

    return images


def extract_links_path(html: str) -> list[str]:
    link_line: list[str]
    links: list[str] = []

    link_line = re.findall(r"<a\s[^>]*>", html, re.IGNORECASE)

    for tag_a in link_line:
        matchs = re.search(
            r'\shref=(?:"([^\"]*)"|\'([^\']*)\'|([^\s>]+))',
            tag_a,
            re.IGNORECASE
        )
        if matchs and any(matchs.groups()):
            links.append(
                (matchs.group(1) or matchs.group(2) or matchs.group(3))
                .replace("&amp;", "&")
            )

    return links


def mount_url_path(url: str, path: str) -> str:
    schema, base, origin, _ = split_url(url)
    # print(schema, base, origin, resto)
    if path:
        if path.startswith("//"):
            # print("1")
            completed_url = schema + ":" + path

        elif path.startswith("/"):
            # print("2")
            completed_url = schema + "://" + origin + path
        else:
            # print("3")
            corte = base.rfind("/")
            caminho = base[:corte + 1]
            completed_url = schema + "://" + caminho + path
    return completed_url


