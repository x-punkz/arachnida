#!/usr/bin/env python3
import urllib.request
import argparse
from http.client import HTTPException
import os
import re

# Accepted file extensions and content types
ACCEPTED = {
        ".jpeg": "image/jpeg",
        ".jpg": "image/jpeg",
        ".png": "image/png",
        ".gif": "image/gif",
        ".bmp": "image/bmp",
    }
# Attributes for searching for images with lazy loadings
IMG_ATTR = ("data-src", "src", "data-lazy-src", "data-original")


# Header to prevent a 403 error when using urllib.request
HEADERS = {
        "User-Agent": ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                       "AppleWebKit/537.36 (KHTML, like Gecko) "
                       "Chrome/157.0.0.0 Safari/537.36"),
        "Accept": ("text/html,application/xhtml+xml,application/xml;q=0.9,"
                   "image/avif,*/*;q=0.8"),
        "Accept-Language": "pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7,es;q=0.6",
        "Referer": "https://google.com",
        "Connection": "keep-alive"
    }
# Colors
GREEN = "\033[32m[+] \033[0m"
BLOCK = "\033[32m#\033[0m"
RED = "\033[31m[*] \033[0m"
YLW = "\033[33m[!] \033[0m"


def recursive_parse(
        parser: argparse.ArgumentParser,
        args: argparse.Namespace
        ) -> int:
    if args.limit is not None and not args.recursive:
        parser.error("The [-l] option requires that recursive mode [-r] be "
                     "enabled.")

    if args.limit is not None and args.limit <= 0:
        parser.error("The value of [-l] must be greater than 0.")

    if args.limit is None:
        args.limit = 5

    return args.limit


def split_url(url: str) -> list[str]:
    schema = url.partition("://")[0]
    host = url.split("://", 1)[-1]
    host_port, rest = re.match(r'([^/?#]*)(.*)', host).groups()

    return (schema, host, host_port, rest)


def url_validate(url: str) -> None | str:
    if not url.lower().startswith(("https://", "http://")):
        return f"{RED}The [url] must begin with http:// or https://.\n"

    _, host, host_port, _ = split_url(url)

    if host.startswith("["):
        return "IPv6 not supported."

    domain, sep, port = host_port.partition(":")

    labels = domain.split(".")
    is_valid_domain = True
    for label in labels:
        # `fullmatch` only returns a result if the entire text matches
        # the rule, and returns either a `match` or `none` object
        if not re.fullmatch(r"[a-zA-Z0-9-]{1,63}", label):
            is_valid_domain = False
            break
        if label.startswith("-") or label.endswith("-"):
            is_valid_domain = False
            break

    if not is_valid_domain:
        return f"{RED}In URL, [domain] is invalid.\n"

    if sep == ":":
        if (not (port.isascii() and port.isdigit())
                or int(port) not in range(1, 65536)):
            return f"{RED}In URL, [port] is invalid.\n"

    return None


def path_validate_and_create(path: str) -> None | str:
    if os.path.exists(path):
        if not os.path.isdir(path):
            return f"{RED}[path] is not a directory."

        if not os.access(path, os.W_OK | os.X_OK):
            return f"{RED}The directory in [path] is not writable."
    else:
        try:
            os.makedirs(path, exist_ok=True)
            print(
                f"{GREEN}[INFO] The directory does not exist in the path!\n"
                f"{GREEN}Created directory '{path}'"
                )
        except OSError as e:
            return f"{RED}Cannot create directory '{path}': {e}"

    return None


def arguments() -> tuple[bool, int, str, str]:
    parser = argparse.ArgumentParser(
        prog='Spider',
        formatter_class=argparse.RawTextHelpFormatter,
        description="The spider program allow you to extract all the images "
        "from a website,\n recursively, by providing a url as a parameter.\n"
        "By default, the program will download the following file "
        "extensions:\n"
        "   .jpg/.jpeg, .png, .gif, .bmp",
        epilog='''Examples:
        ./spider -r -l 8 https://www.example.com
        ./spider -r -p /home/user/data https://www.example.com

        [-l] is only used if -r is also being used;
            Otherwise, [-l] will not work.
        If -l is not define, it defaults to "5".
        If -p is not define, the default is "./data/".''',
        # color=False  # leave the menu in volor or not
    )
    parser.add_argument(
        "-r",
        "--recursive",
        action='store_true',
        help='Recursively downloads the images in a URL received '
        'as a parameter',
    )

    parser.add_argument(
        "-l",
        "--limit",
        type=int,
        default=None,
        help="Set the recursion value"
    )

    parser.add_argument(
        "-p",
        "--path",
        type=str,
        help="Set the path for saving the download",
        default="./data/"
    )

    parser.add_argument(
        "url",
        type=str,
        help="The URL of the website from which the images are to be extracted"
    )

    args = parser.parse_args()

    args.limit = recursive_parse(parser, args)

    url_error = url_validate(args.url)
    if url_error:
        parser.error(url_error)

    path_error = path_validate_and_create(args.path)
    if path_error:
        parser.error(path_error)

    return (args.recursive, args.limit, args.path, args.url)


def get_page(url: str) -> tuple[str | None, str | None]:
    try:
        url_w_headers = urllib.request.Request(url, headers=HEADERS)
        with urllib.request.urlopen(url_w_headers, timeout=5) as resp:
            content = resp.headers.get_content_type()
            if content != "text/html":
                print(f"{YLW}Ignored: {url} is {content}\n")
                return None, None
            data = resp.read()
            charset = resp.headers.get_content_charset("utf-8")
            converted_data = data.decode(charset, errors="replace")
            return (converted_data, resp.url)
    except (OSError, HTTPException, ValueError) as e:
        print(f"{RED}{e}\n")
        return None, None


def get_attr(attr: str, img_tag: str) -> str | None:
    matchs = re.search(
        rf'\s{re.escape(attr)}=(?:"([^\"]*)"|\'([^\']*)\'|([^\s>]+))',
        img_tag,
        re.IGNORECASE
    )
    if matchs and any(matchs.groups()):
        clean_img = ((matchs.group(1) or
                      matchs.group(2) or
                      matchs.group(3))).replace("&amp;", "&")
        if clean_img == "":
            return None
        else:
            return clean_img
    return None


def extract_images_path(html: str) -> list[str]:
    images_line: list[str]
    images: list[str] = []

    images_line = re.findall(r"<img\s[^>]*>", html, re.IGNORECASE)

    for tag in images_line:
        for attr in IMG_ATTR:
            src = get_attr(attr, tag)
            if src:
                break

        else:
            continue
        if src.lower().startswith("data:"):
            continue

        path_only = re.split(r"[?#]", src, maxsplit=1)[0]
        ext = os.path.splitext(path_only)[-1].lower()

        if ext and ext not in ACCEPTED:
            continue
        images.append(src)

    return images


def extract_links_path(html: str) -> list[str]:
    link_line: list[str]
    links: list[str] = []

    link_line = re.findall(r"<a\s[^>]*>", html, re.IGNORECASE)

    for tag_a in link_line:
        matchs = re.search(
            r'\shref=(?:"([^\"]*)"|\'([^\']*)\'|([^\s>]+))',
            tag_a,
            re.IGNORECASE
        )
        if matchs and any(matchs.groups()):
            links.append(
                (matchs.group(1) or matchs.group(2) or matchs.group(3))
                .replace("&amp;", "&")
            )

    return links


def resolve_dots(rest_url: str) -> str:
    pieces = rest_url.split("/")
    result: list[str] = []

    for piece in pieces:
        if piece == "..":
            if len(result) > 1:
                result.pop()
        elif piece != ".":
            result.append(piece)

    if pieces[-1] in (".", ".."):
        result.append("")

    return "/".join(result)


def mount_url_path(url: str, path: str) -> str:
    scheme, _, origin, rest = split_url(url)

    if path.startswith("//"):
        return scheme + ":" + path

    if path.lower().startswith(("http://", "https://")):
        return path

    if not path.startswith("/"):
        # relative: usa a pasta da base (sem consulta)
        base_path = re.split(r"[?#]", rest, maxsplit=1)[0]
        folder = base_path[:base_path.rfind("/") + 1] or "/"
        path = folder + path

    match = re.match(r"([^?#]*)(.*)", path)
    assert match
    new_path, query = match.groups()
    return scheme + "://" + origin + resolve_dots(new_path) + query


def downloaded_verify(dest_path: str, img_name: str) -> str:
    i = 1
    orig_name = img_name
    while os.path.exists(os.path.join(dest_path, img_name)):
        name, ext = os.path.splitext(orig_name)
        name += f"({i})"
        img_name = name + ext
        i += 1
        print(f"{YLW}{orig_name} already exists!")
        print(f"{GREEN}Creating {img_name}\n")
    return img_name


def download_images(url: str, dest_path: str) -> bool:
    img_dest_path: str = None
    try:
        url_w_headers = urllib.request.Request(url, headers=HEADERS)
        with urllib.request.urlopen(url_w_headers, timeout=5) as resp:
            content_type = resp.headers.get_content_type()
            if content_type not in ACCEPTED.values():
                print(f"{YLW}[ERROR] Ignored, the content "
                      f"'{content_type}' isn't an acceptable image\n")
                return False

            img_name = re.split(r"[?#]", url.split("/")[-1])[0]
            name, extension = os.path.splitext(img_name)

            if name.startswith(".") or not name:
                print(f"{YLW}[ERROR] Invalid image\n")
                return False

            if not extension:
                img_name += "." + content_type.split("/")[-1]

            elif extension.lower() not in ACCEPTED:
                print(f"{YLW}[ERROR] The image file extension "
                      "isn't accepted\n")
                return False

            img_name = downloaded_verify(dest_path, img_name)

            img_dest_path = os.path.join(dest_path, img_name)

            len_chunck = 0
            content_len = resp.headers.get("Content-Length")
            with open(img_dest_path, "wb") as img_copy:
                while True:
                    if content_len and int(content_len) > 0:
                        percent = (int(len_chunck) / int(content_len)) * 100
                        block = int(percent // 5)
                    else:
                        # Depois ver esse if !!!!!
                        percent = 100
                        block = 100
                    print(f" Progress... [{BLOCK * block:<20}]"
                          f"{percent:.0f}%", end="\r", flush=True)

                    chunk = resp.read(32 * 1024)
                    len_chunck += len(chunk)
                    if chunk == b"":
                        break
                    img_copy.write(chunk)
            if content_len is not None and len_chunck != int(content_len):
                raise OSError(f"\n\n{RED}[ERROR] Incomplete File.\n")

            print(f"\n Image '{img_name}' saved in {dest_path}.\n")
            return True

    except (OSError, HTTPException, ValueError) as e:
        if img_dest_path is not None and os.path.exists(img_dest_path):
            os.remove(img_dest_path)
        print(f"{RED}{e}\n")

        return False


def process_page(url: str, path: str, downloaded: set) -> list[str]:
    images: list[str] = []
    links: list[str] = []
    mounted_path: list[str] = []
    mount_path_link: list[str] = []

    pure_html, final_url = get_page(url)
    if pure_html is None or final_url is None:
        print(f"{RED}[ERROR] Html is not found.")
        return []

    images = extract_images_path(pure_html)
    links = extract_links_path(pure_html)

    mounted_path = [mount_url_path(final_url, image) for image in images]
    mount_path_link = [mount_url_path(final_url, link) for link in links]

    print(f"{GREEN}[INFO] Starting download...")
    for img in mounted_path:
        if img in downloaded:
            continue
        if not download_images(img, path):
            continue

        downloaded.add(img)
    return mount_path_link


def bfs(base: str, path: str, downloaded: set, limit: int) -> None:
    visited = {base}
    curr_level = [base]

    for depth in range(limit + 1):
        next_level = []
        print(f"{RED}{RED}Recursion depth: '{depth}'{RED}{RED}")
        url_link = 1
        for link in curr_level:
            print(f"{RED}{RED}Link: '{url_link}'{RED}{RED}")
            extracted_links = process_page(link, path, downloaded)
            for x_link in extracted_links:
                if x_link not in visited:
                    visited.add(x_link)
                    next_level.append(x_link)
            url_link += 1
        curr_level = next_level


def main() -> None:
    # ignored = len(mounted_path) - len(downloaded)
    # print(f"{YLW}[INFO] {ignored} images duplicated or ignorated!")
    # print(f"{GREEN}[INFO] Download is completed!")
    is_recursive, limit, path, url = arguments()
    downloaded = set()

    if is_recursive:
        bfs(url, path, downloaded, limit)
    else:
        process_page(url, path, downloaded)

