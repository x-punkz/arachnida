def main() -> None:
    images: list[str] = []
    links: list[str] = []

    is_recursive, limit, path, url = arguments()
    pure_html, final_url = get_page(url)
    if pure_html is None or final_url is None:
        return "[Error] Html is not found"

    images = extract_images_path(pure_html)
    links = extract_links_path(pure_html)

    mounted_path: list[str] = []
    mounted_path = [mount_url_path(final_url, image) for image in images]
    print(*mounted_path, sep="\n")

    mounted_path = []
    mounted_path = [mount_url_path(final_url, link) for link in links]
    print(*mounted_path, sep="\n")

    # print(f"\nImages => {images}\n")
    # print(*links, sep="\n")
    print()


